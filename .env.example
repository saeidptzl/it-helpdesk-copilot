# Copy to .env and adjust. Every value is optional: the defaults below are used when unset.

# Models (pulled automatically by the model-pull service on first start)
CHAT_MODEL=qwen2.5:1.5b
EMBED_MODEL=nomic-embed-text
OLLAMA_IMAGE_TAG=0.40.16
OLLAMA_KEEP_ALIVE=30m

# Web UI port on the host (always bound to 127.0.0.1)
APP_PORT=8000

# Retrieval gates (calibrated for nomic-embed-text; re-run `python -m app.evaluate retrieval` after changes)
TOP_K=4
MIN_SCORE=0.60
CONFIDENT_SCORE=0.70
AMBIGUITY_MARGIN=0.035
MIN_SHARED_TERMS=2

# Answer checks: minimum share of a step's words found in its cited section
MIN_GROUNDING=0.35

# Generation
NUM_CTX=4096
NUM_PREDICT=800
REPEAT_PENALTY=1.1
LLM_TIMEOUT_S=240

# Only for running without Docker (python -m app). Docker Compose sets these itself.
# OLLAMA_URL=http://127.0.0.1:11434
# INDEX_PATH=data/index.sqlite3
# HOST=127.0.0.1
# PORT=8000
